{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuvis.ai/schemas/dataset/dataset_list.schema.json",
  "title": "dataset list --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tags", "cameras", "datasets"],
  "properties": {
    "schema_version": {"const": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "cameras": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/dspec"}}
  },
  "$defs": {
    "dspec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "display_name", "summary", "repo_id", "target_dir", "revision", "size_bytes",
        "file_count", "license", "tags", "camera", "description", "aliases"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "maxLength": 60},
        "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "target_dir": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "license": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "camera": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
